# ─────────────────────────────────────────────────────────────
# Mirantic CMS — environment variables
# Copy to .env.local for local dev. In production, set these in
# the Vercel project settings (Settings → Environment Variables).
# ─────────────────────────────────────────────────────────────

# ── Auth0 (frontend, must be prefixed VITE_ to be exposed to the browser) ──
VITE_AUTH0_DOMAIN=your-tenant.eu.auth0.com
VITE_AUTH0_CLIENT_ID=your-spa-client-id
# The API "audience" identifier you set on the Auth0 API. Tokens are issued for this.
VITE_AUTH0_AUDIENCE=https://app.mirantic.com/api

# ── Auth0 (backend / serverless — used to validate incoming tokens) ──
AUTH0_DOMAIN=your-tenant.eu.auth0.com
AUTH0_AUDIENCE=https://app.mirantic.com/api

# ── Auth0 Management API (backend — used to create client users + send invites) ──
# Create a Machine-to-Machine app authorized for the Auth0 Management API with
# scopes: create:users, read:users, update:users, create:user_tickets.
AUTH0_M2M_CLIENT_ID=your-m2m-client-id
AUTH0_M2M_CLIENT_SECRET=your-m2m-client-secret

# ── Neon Postgres ──
DATABASE_URL=postgres://user:password@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# ── GitHub (backend — used to commit content.json on publish) ──
# Fine-grained PAT with Contents: read/write on the client site repos.
GITHUB_TOKEN=github_pat_xxx

# ── Vercel Blob (backend — image upload storage) ──
# Create a Blob store in the Vercel dashboard; this token is provided there.
# If unset, image fields fall back to pasting a URL (no file upload).
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx

# ── App ──
# Used in invite emails / callback construction. No trailing slash.
APP_URL=https://app.mirantic.com

# ── Email (Resend) — invite emails ──
# API key from https://resend.com/api-keys
RESEND_API_KEY=
# Must be a verified domain in Resend, e.g. "Mirantic <invites@mirantic.com>".
# If unset, invites are still created but must be sent by hand.
INVITE_FROM=
